#!groovy

/**
 * Pipeline for å release artifakter for launcher til Maven repository.
 * Versjonen som skal releases må være tagget med versjonsnummeret i Git.
 */

@Library('common') _

pipeline {
    agent {
        node {
            label 'matrikkelen'
        }
    }

    tools {
        jdk 'Java 11 Latest'
    }

    environment {
        // Forhindre samtidighetsproblemer
        // Tilsvarer "Force GRADLE_USER_HOME to use workspace" i "Gradle plugin"
        GRADLE_USER_HOME = "${WORKSPACE}/gradle"

        GRADLEW_OPTIONS =
            "-Dmaven.repo.local=${WORKSPACE}/.m2/repository " +
            "-Dfile.encoding=UTF8 " +
            "--no-daemon " +
            "--stacktrace"
        GRADLEW_CMD = "./gradlew ${GRADLEW_OPTIONS}"

        // URI for repository som det skal deployes til
        // Denne må være på formen http(s)://<brukernavn>:<passord>@<repository>
        MAVEN_PUBLISH = credentials('MAVEN_DEPLOY_RELEASES')

        GIT_URL = 'ssh://git@bitbucket.statkart.no:7999/laun/launcher.git'
        GIT_CREDENTIALS = '2c90ed8a-1f70-41f3-92e9-ce54dbd353c7' // builder2
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
    }

    parameters {
        string(
                name: 'version',
                defaultValue: '',
                description: 'Versjonen som skal publiseres, f.eks. "1.2.1". Merk at denne må være samme som taggen i Git.',
                trim: true
        )
    }

    stages {
        stage('Valider') {
            steps {
                script {
                    if (params.version == '') {
                        currentBuild.result = 'ABORTED'
                        error('Versjon må oppgis!')
                    }
                }
            }
        }

        stage('Checkout launcher') {
            steps {
                gitShallowCheckout("refs/tags/${params.version}", GIT_URL, GIT_CREDENTIALS)
            }
        }

        stage('Prepare launcher') {
            steps {
                // Den neste linjen kan fjernes etter hvert, men t.o.m. 1.2.12 må dette gjøres
                sh 'chmod +x gradlew'
                sh "${GRADLEW_CMD} clean"
            }
        }

        stage('Publish launcher') {
            steps {
                sh "${GRADLEW_CMD} publish -Plauncher_version=${params.version}"
            }
        }
    }

    post {
        success {
            deleteDir()
        }
        cleanup {
            sendNotifications(currentBuild.result, 'launcher')
        }
    }
}
